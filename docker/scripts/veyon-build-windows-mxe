#!/usr/bin/env bash
set -Eeuo pipefail

SRC_DIR="${SRC_DIR:-/workspace/veyon}"
BUILD_DIR="${BUILD_DIR:-${SRC_DIR}/build-win64-qt5-notrans}"
BUILD_PARALLEL="${BUILD_PARALLEL:-1}"
MXE_PATH="${MXE_PATH:-/opt/mxe}"
MXE_TARGET="${MXE_TARGET:-x86_64-w64-mingw32.shared}"
CMAKE_BUILD_TYPE="${CMAKE_BUILD_TYPE:-Release}"
WITH_TRANSLATIONS="${WITH_TRANSLATIONS:-OFF}"
WITH_LDAP="${WITH_LDAP:-OFF}"
WITH_WEBAPI="${WITH_WEBAPI:-OFF}"
WITH_BUILTIN_LIBVNC="${WITH_BUILTIN_LIBVNC:-ON}"
WINDOWS_BINARIES="${WINDOWS_BINARIES:-1}"
WINDOWS_INSTALLER="${WINDOWS_INSTALLER:-0}"

export PATH="${MXE_PATH}/usr/bin:${MXE_PATH}/usr/x86_64-pc-linux-gnu/bin:${MXE_PATH}/usr/${MXE_TARGET}/bin:${PATH}"

ensure_makensis() {
    if command -v makensis >/dev/null 2>&1; then
        return 0
    fi

    local tools_dir=/tmp/veyon-docker-tools
    local candidates=(
        "${MXE_PATH}/usr/bin/makensis"
        "${MXE_PATH}/usr/x86_64-pc-linux-gnu/bin/makensis"
        "${MXE_PATH}/usr/${MXE_TARGET}/bin/makensis"
    )

    shopt -s nullglob
    candidates+=("${MXE_PATH}"/usr/bin/*makensis*)
    shopt -u nullglob

    for candidate in "${candidates[@]}"; do
        if [[ -x "${candidate}" ]]; then
            mkdir -p "${tools_dir}"
            ln -sf "${candidate}" "${tools_dir}/makensis"
            export PATH="${tools_dir}:${PATH}"
            printf '==> Using makensis: %s\n' "${candidate}"
            return 0
        fi
    done

    printf 'ERROR: makensis not found. Build MXE package nsis first with: veyon-build-mxe\n' >&2
    return 2
}

if [[ ! -f "${SRC_DIR}/CMakeLists.txt" ]]; then
    printf 'ERROR: SRC_DIR does not look like a Veyon/EduMonitor source tree: %s\n' "${SRC_DIR}" >&2
    exit 2
fi

if [[ ! -d "${MXE_PATH}/usr/${MXE_TARGET}" ]]; then
    printf 'ERROR: MXE target is missing: %s/usr/%s\n' "${MXE_PATH}" "${MXE_TARGET}" >&2
    printf '       Build it first with: veyon-build-mxe\n' >&2
    exit 2
fi

cmake_args=(
    -S "${SRC_DIR}"
    -B "${BUILD_DIR}"
    -DCMAKE_BUILD_TYPE="${CMAKE_BUILD_TYPE}"
    -DCMAKE_TOOLCHAIN_FILE="${SRC_DIR}/cmake/modules/Win64Toolchain.cmake"
    -DMXE_PATH="${MXE_PATH}"
    -DMINGW_TARGET="${MXE_TARGET}"
    -DCMAKE_PREFIX_PATH="${MXE_PATH}/usr/${MXE_TARGET}/qt5"
    -DCMAKE_INSTALL_PREFIX=/
    -DWITH_QT6=OFF
    -DWITH_TRANSLATIONS="${WITH_TRANSLATIONS}"
    -DWITH_LDAP="${WITH_LDAP}"
    -DWITH_WEBAPI="${WITH_WEBAPI}"
    -DWITH_BUILTIN_LIBVNC="${WITH_BUILTIN_LIBVNC}"
)

if [[ -n "${CMAKE_EXTRA_ARGS:-}" ]]; then
    # shellcheck disable=SC2206 # Intentional simple splitting for Docker env overrides.
    extra_args=(${CMAKE_EXTRA_ARGS})
    cmake_args+=("${extra_args[@]}")
fi

printf '==> Configuring Windows/MXE build in %s\n' "${BUILD_DIR}"
cmake "${cmake_args[@]}"

build_args=(--build "${BUILD_DIR}" --parallel "${BUILD_PARALLEL}")
if [[ -n "${BUILD_TARGET:-}" ]]; then
    build_args+=(--target "${BUILD_TARGET}")
fi

printf '==> Building Windows/MXE targets with %s parallel job(s)\n' "${BUILD_PARALLEL}"
cmake "${build_args[@]}"

check_runtime_files() {
    local missing=0
    local files=(
        "${MXE_PATH}/usr/${MXE_TARGET}/bin/libstdc++-6.dll"
        "${MXE_PATH}/usr/${MXE_TARGET}/bin/libgcc_s_seh-1.dll"
        "${MXE_PATH}/usr/${MXE_TARGET}/bin/libwinpthread-1.dll"
        "${MXE_PATH}/usr/${MXE_TARGET}/bin/interception.dll"
        "${MXE_PATH}/usr/${MXE_TARGET}/qt5/bin/libqca-qt5.dll"
        "${MXE_PATH}/usr/${MXE_TARGET}/qt5/plugins/crypto/libqca-ossl.dll"
        "${MXE_PATH}/usr/${MXE_TARGET}/qt5/plugins/platforms/qwindows.dll"
        "${MXE_PATH}/usr/${MXE_TARGET}/qt5/plugins/imageformats/qjpeg.dll"
        "${MXE_PATH}/usr/${MXE_TARGET}/qt5/plugins/imageformats/qsvg.dll"
        "${MXE_PATH}/usr/${MXE_TARGET}/qt5/plugins/iconengines/qsvgicon.dll"
    )

    if [[ "${WITH_BUILTIN_LIBVNC}" != "1" && "${WITH_BUILTIN_LIBVNC}" != "ON" && "${WITH_BUILTIN_LIBVNC}" != "true" ]]; then
        files+=(
            "${MXE_PATH}/usr/${MXE_TARGET}/bin/libvncclient.dll"
            "${MXE_PATH}/usr/${MXE_TARGET}/bin/libvncserver.dll"
        )
    fi

    for file in "${files[@]}"; do
        if [[ ! -e "${file}" ]]; then
            printf 'Missing Windows runtime dependency: %s\n' "${file}" >&2
            missing=1
        fi
    done

    return "${missing}"
}

if [[ "${WINDOWS_BINARIES}" == "1" || "${WINDOWS_BINARIES}" == "ON" || "${WINDOWS_BINARIES}" == "true" ]]; then
    printf '==> Checking Windows runtime files before packaging\n'
    check_runtime_files
    printf '==> Creating portable Windows directory\n'
    cmake --build "${BUILD_DIR}" --target windows-binaries --parallel "${BUILD_PARALLEL}"
fi

if [[ "${WINDOWS_INSTALLER}" == "1" || "${WINDOWS_INSTALLER}" == "ON" || "${WINDOWS_INSTALLER}" == "true" ]]; then
    ensure_makensis
    printf '==> Creating Windows NSIS installer\n'
    cmake --build "${BUILD_DIR}" --target create-windows-installer --parallel "${BUILD_PARALLEL}"
fi
